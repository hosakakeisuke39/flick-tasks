{
  "name": "flick-tasks",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vite",
    "build": "vite build",
    "build:dev": "CLOUDFLARE_ENV=dev vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:e2e": "playwright test",
    "deploy": "node scripts/ensure-d1.mjs && wrangler d1 migrations apply DB --remote && npm run build && wrangler deploy"
  },
  "license": "ISC",
  "dependencies": {
    "arctic": "^3.7.0",
